{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BOSS AI decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "intent", "action", "replyText", "resumeAssetId", "evidenceFactIds", "missingFacts", "reasonCode"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "requestId": {"type": "string"},
    "intent": {"enum": ["REQUEST_RESUME", "CONFIRM_LOCATION", "OTHER", "MIXED", "UNKNOWN"]},
    "action": {"enum": ["SEND_RESUME", "CONFIRM_LOCATION", "SUGGEST_REPLY", "NEEDS_INFORMATION", "NO_ACTION"]},
    "replyText": {"type": "string", "maxLength": 300},
    "resumeAssetId": {"type": "string"},
    "evidenceFactIds": {"type": "array", "items": {"type": "string", "maxLength": 500}},
    "missingFacts": {"type": "array", "items": {"type": "string", "maxLength": 500}},
    "reasonCode": {"type": "string", "maxLength": 120}
  }
}
